{
  "name": "opencode-gen-speed",
  "version": "0.0.1",
  "description": "OpenCode 2 TUI plugin: live generation speed, first-token time, and token usage for the current session.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tokens",
    "tps",
    "speed",
    "stats"
  ],
  "engines": {
    "opencode": ">=2.3.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
