  "devDependencies": {
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/node": "^26.6.6",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PazzaRorschach/opencode-gen-speed.git"
  },
  "homepage": "https://github.com/PazzaRorschach/opencode-gen-speed#readme",
  "bugs": {
    "url": "https://github.com/PazzaRorschach/opencode-gen-speed/issues"
